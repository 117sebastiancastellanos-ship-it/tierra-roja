            <span class="font-serif font-bold text-gold-300 text-lg">TR</span>
          </div>

          <!-- Silueta artística SVG de la botella Tierra Roja -->
          <div class="relative my-2 py-4">
            <svg class="w-32 h-64 mx-auto filter drop-shadow-[0_15px_15px_rgba(0,0,0,0.6)]" viewBox="0 0 100 240" fill="none" xmlns="http://www.w3.org/2000/svg">
              <!-- Cuello y pico con cera sellada -->
              <path d="M44 8 H56 V35 H44 Z" fill="#380812"/>
              <path d="M43 6 C43 4.5 45 4 50 4 C55 4 57 4.5 57 6 L57 16 C55 18 53 16 50 18 C47 16 45 18 43 16 Z" fill="#641323" stroke="#d4af37" stroke-width="0.8"/>
              
