      <div class="flex-1 text-center lg:text-left space-y-6">
        
        <!-- Badge de lote y origen -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/10 border border-gold-400/30 backdrop-blur-md">
