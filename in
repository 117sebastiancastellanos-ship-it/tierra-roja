  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            tierra: {
              950: '#1b0509',
              900: '#2d0a11',
              800: '#460e19',
              700: '#641323',
              600: '#8a1c32',
              500: '#ab2742',
              100: '#fae8eb',
