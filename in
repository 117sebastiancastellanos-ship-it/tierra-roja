  <!-- Open Graph / Meta para compartir en redes -->
  <meta property="og:title" content="Tierra Roja | Vino Artesanal de Frutos Rojos" />
  <meta property="og:description" content="Vino dulce artesanal elaborado con fresa, mora y frambuesa. Lotes limitados y trazabilidad completa. De la tierra al corazón." />
  <meta property="og:type" content="website" />

  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>

  <!-- Google Fonts: Playfair Display + Cormorant Garamond + Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400&family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,700;1,400&display=swap" rel="stylesheet" />

