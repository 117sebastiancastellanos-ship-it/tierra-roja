  <style>
    /* Estilos personalizados para efectos vítreos y ornamentos */
    .glass-card {
      background: rgba(253, 251, 247, 0.85);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border: 1px solid rgba(212, 175, 55, 0.25);
    }
    .dark-glass {
      background: rgba(45, 10, 17, 0.78);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      border: 1px solid rgba(212, 175, 55, 0.2);
    }
    .wax-seal {
      box-shadow: 0 4px 15px rgba(100, 19, 35, 0.4), inset 0 2px 5px rgba(255, 255, 255, 0.3), inset 0 -3px 5px rgba(0, 0, 0, 0.4);
    }
    .text-glow {
      text-shadow: 0 0 20px rgba(212, 175, 55, 0.35);
    }
    /* Suavizado de bordes y pergaminos */
    ::selection {
      background-color: #641323;
      color: #f3e3a4;
    }
