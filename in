  <script>
    // Inicializar iconos de Lucide
    lucide.createIcons();

    // Gestión del Menú Móvil
    const mobileMenuBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    const mobileLinks = document.querySelectorAll('.mobile-nav-link');

    if (mobileMenuBtn && mobileMenu) {
      mobileMenuBtn.addEventListener('click', () => {
        mobileMenu.classList.toggle('hidden');
      });

      mobileLinks.forEach(link => {
        link.addEventListener('click', () => {
          mobileMenu.classList.add('hidden');
        });
      });
    }

    // Scroll Header Styling
    const mainNav = document.getElementById('main-nav');
    window.addEventListener('scroll', () => {
      if (window.scrollY > 40) {
        mainNav.classList.add('shadow-md', 'bg-white/95');
        mainNav.classList.remove('bg-white/80');
      } else {
        mainNav.classList.remove('shadow-md', 'bg-white/95');
        mainNav.classList.add('bg-white/80');
      }
    });

    // Lógica del Simulador / Calculadora de Pedidos
    const bottlePrice = 180;
    const giftPackagePrice = 35;

    let bottleCount = 1;
    const bottleCountEl = document.getElementById('bottle-count');
    const totalPriceEl = document.getElementById('total-price');
    const btnDecrease = document.getElementById('btn-decrease');
    const btnIncrease = document.getElementById('btn-increase');
    const checkGift = document.getElementById('check-gift');
    const btnWhatsapp = document.getElementById('btn-whatsapp');
    const clientNameInput = document.getElementById('client-name');
    const clientNoteInput = document.getElementById('client-note');

    function calculateTotal() {
      let total = bottleCount * bottlePrice;
      if (checkGift && checkGift.checked) {
        total += (giftPackagePrice * bottleCount);
      }
      if (totalPriceEl) {
        totalPriceEl.textContent = total;
      }
    }

    if (btnDecrease && btnIncrease) {
      btnDecrease.addEventListener('click', () => {
        if (bottleCount > 1) {
          bottleCount--;
          bottleCountEl.textContent = bottleCount;
          calculateTotal();
        }
      });

      btnIncrease.addEventListener('click', () => {
        if (bottleCount < 30) { // Límite de lote artesanal
          bottleCount++;
          bottleCountEl.textContent = bottleCount;
          calculateTotal();
        }
      });
    }

    if (checkGift) {
      checkGift.addEventListener('change', calculateTotal);
    }

    // Modal Helper
    const infoModal = document.getElementById('info-modal');
    const modalTitle = document.getElementById('modal-title');
    const modalDesc = document.getElementById('modal-desc');
    const modalCloseBtn = document.getElementById('modal-close-btn');

    function showModal(title, message) {
      if (modalTitle && modalDesc && infoModal) {
        modalTitle.textContent = title;
        modalDesc.textContent = message;
        infoModal.classList.remove('hidden');
      }
    }

    if (modalCloseBtn && infoModal) {
      modalCloseBtn.addEventListener('click', () => {
        infoModal.classList.add('hidden');
      });
    }

    // Envío por WhatsApp con mensaje formateado
    if (btnWhatsapp) {
      btnWhatsapp.addEventListener('click', () => {
        const clientName = clientNameInput.value.trim() || 'Cliente interesado';
        const clientNote = clientNoteInput.value.trim();
        const giftSelected = checkGift.checked ? 'Sí (con envoltura de estraza y sello especial de cera)' : 'Presentación estándar';
        const totalAmount = totalPriceEl.textContent;

        let mensaje = `*¡Hola Tierra Roja! Deseo apartar mi pedido de vino artesanal:* %0A%0A`;
        mensaje += `🍷 *Cantidad:* ${bottleCount} botella(s) de Vino Dulce de Frutos Rojos (750ml)%0A`;
        mensaje += `🎁 *Empaque para regalo:* ${giftSelected}%0A`;
        mensaje += `💰 *Total estimado:* $${totalAmount} MXN%0A`;
        mensaje += `👤 *Nombre:* ${clientName}%0A`;
        if (clientNote) {
          mensaje += `📝 *Nota especial / dedicatoria:* ${clientNote}%0A`;
        }
        mensaje += `%0A¿Me podrían indicar los datos de entrega y disponibilidad del lote actual? Gracias.`;

        // Abrir enlace directo a WhatsApp (reemplazar número si se requiere por el de ventas)
        const phone = "5215500000000"; // Número comodín configurable
        const waUrl = `https://api.whatsapp.com/send?phone=${phone}&text=${mensaje}`;
        window.open(waUrl, '_blank');
      });
    }

    // FAQ Acordeón Interactivo
    const faqButtons = document.querySelectorAll('.faq-toggle');
    faqButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const content = btn.nextElementSibling;
        const icon = btn.querySelector('[data-lucide="chevron-down"]');
        const isHidden = content.classList.contains('hidden');

        // Cerrar todos los demás
        document.querySelectorAll('.faq-content').forEach(c => c.classList.add('hidden'));
        document.querySelectorAll('.faq-toggle [data-lucide="chevron-down"]').forEach(i => {
          i.style.transform = 'rotate(0deg)';
        });

        if (isHidden) {
          content.classList.remove('hidden');
          if (icon) icon.style.transform = 'rotate(180deg)';
        } else {
          content.classList.add('hidden');
          if (icon) icon.style.transform = 'rotate(0deg)';
        }
      });
    });
  </script>
