    <div class="absolute -bottom-40 -right-40 w-96 h-96 rounded-full bg-gold-500/10 blur-3xl pointer-events-none"></div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 flex flex-col lg:flex-row items-center gap-12 lg:gap-16">
      
