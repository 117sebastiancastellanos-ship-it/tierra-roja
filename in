  <!-- Sección: El Vino y Trilogía de Frutos -->
  <section id="vino" class="py-20 bg-parchment-100 text-stone-800 relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-16 space-y-3">
        <span class="text-xs uppercase font-bold tracking-widest text-tierra-700 bg-tierra-100 px-3 py-1 rounded-full border border-tierra-700/20">
          Identidad de la Cosecha
        </span>
        <h2 class="font-serif text-3xl sm:text-4xl font-bold text-tierra-900">
          La Trilogía de Frutos Rojos
        </h2>
        <p class="text-stone-600 leading-relaxed font-light">
          A diferencia de los vinos industriales que emplean saborizantes o azúcar adicionada, Tierra Roja extrae su complejidad de tres frutos seleccionados a mano en mercados y productores regionales.
        </p>
      </div>

      <!-- Tarjetas de Frutos -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-16">
        
        <!-- Fresa -->
        <div class="bg-white rounded-2xl p-6 shadow-sm border border-stone-200/80 hover:border-gold-500/50 hover:shadow-lg transition-all duration-300 flex flex-col items-center text-center group">
