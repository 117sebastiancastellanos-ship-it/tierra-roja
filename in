            <div class="w-full bg-stone-200 h-2.5 rounded-full overflow-hidden">
              <div class="bg-gradient-to-r from-tierra-600 to-rose-500 h-2.5 rounded-full" style="width: 85%"></div>
            </div>
          </div>

          <!-- Barra Acidez -->
          <div class="space-y-1">
            <div class="flex justify-between text-xs font-semibold">
              <span class="text-stone-700">Acidez Refrescante</span>
              <span class="text-tierra-700 font-bold">65% (Equilibrada)</span>
            </div>
            <div class="w-full bg-stone-200 h-2.5 rounded-full overflow-hidden">
              <div class="bg-gradient-to-r from-amber-500 to-yellow-500 h-2.5 rounded-full" style="width: 65%"></div>
            </div>
          </div>

          <!-- Barra Aromas Frutales -->
          <div class="space-y-1">
            <div class="flex justify-between text-xs font-semibold">
              <span class="text-stone-700">Intensidad Aromática</span>
              <span class="text-tierra-700 font-bold">95% (Alta presencia de mora y fresa)</span>
            </div>
            <div class="w-full bg-stone-200 h-2.5 rounded-full overflow-hidden">
              <div class="bg-gradient-to-r from-purple-700 to-tierra-700 h-2.5 rounded-full" style="width: 95%"></div>
            </div>
          </div>

