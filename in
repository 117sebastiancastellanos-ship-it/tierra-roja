              <path d="M44 35 C40 45 28 60 28 85 V215 C28 222 34 228 42 228 H58 C66 228 72 222 72 215 V85 C72 60 60 45 56 35 Z" fill="#200409" stroke="#460e19" stroke-width="1.5"/>
              
              <!-- Vino interior reflejo rubí profundo -->
              <path d="M30 110 C30 110 40 105 50 105 C60 105 70 110 70 110 V215 C70 220 65 225 60 225 H40 C35 225 30 220 30 215 Z" fill="url(#wineGradient)"/>
              
              <!-- Etiqueta de la botella -->
